# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Parse Quint ITF traces and replay them against OCaml implementations"
description:
  "Parses Quint ITF (Informal Trace Format) traces, including model-based-testing metadata (action taken, nondeterministic picks), replays them step by step against an OCaml implementation through a driver, and compares observable state with the model. Includes PPX helpers and a quint-connect CLI."
maintainer: ["Mathias Bourgoin <mathias.bourgoin@gmail.com>"]
authors: ["Mathias Bourgoin <mathias.bourgoin@gmail.com>"]
license: "MIT"
homepage: "https://github.com/mathiasbourgoin/ocaml-quint-connect"
bug-reports: "https://github.com/mathiasbourgoin/ocaml-quint-connect/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "yojson"
  "ppxlib" {>= "0.26"}
  "alcotest" {with-test}
  "sqlite3" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mathiasbourgoin/ocaml-quint-connect.git"
